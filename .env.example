# PostgreSQL connection string (Supabase example)
# Ask Aladin for the actual Supabase connection string.
# Runtime connection string (prefer pooled/PgBouncer for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"

# Direct connection string for migrations (no pooler). Optional but recommended.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"

# Auth.js / NextAuth (v5)
# On Vercel you can omit AUTH_URL, but keep it for local dev.
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-strong-random-secret" # e.g. `openssl rand -base64 32`

# If deploying behind a proxy (Vercel), Auth.js recommends trusting the host headers.
AUTH_TRUST_HOST="true"

# Owner/admin
# The product owner always sees admin UI even without an ADMIN role.
OWNER_EMAIL="aladinhindawi@gmail.com"

# Google OAuth (create in Google Cloud Console)
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# TheSportsDB (used to import league fixtures into Rivaly DB)
# Premium key recommended to avoid Cloudflare rate-limits during full-season import.
THE_SPORTS_DB_API_KEY="replace-me"
