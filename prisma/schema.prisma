// Prisma schema for Rivaly
// - PostgreSQL datasource
// - NextAuth/Auth.js (Prisma Adapter) tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional but recommended for serverless: use a pooled URL for runtime and a direct URL for migrations.
  // In Supabase, DATABASE_URL can point at the pooler (PgBouncer) and DIRECT_URL at the direct connection.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountTier {
  FREE
  BASIC
  PRO
  ELITE
  FRIENDS_AND_FAMILY
}

model User {
  id            String      @id @default(cuid())
  name          String?
  username      String?     @unique
  country       String?
  role          UserRole    @default(USER)
  accountTier   AccountTier @default(FREE)
  email         String?     @unique
  image         String?
  emailVerified DateTime?

  accounts Account[]
  sessions Session[]

  // Groups
  createdGroups           Group[]                        @relation("UserCreatedGroups")
  groupMemberships        GroupMember[]
  groupAccuracyAggregates GroupMemberAccuracyAggregate[]

  // Aggregates
  predictionStatsAggregate UserPredictionStatsAggregate?

  // Optional: only present for users who sign up with email+password.
  password UserPassword?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  predictions         Prediction[]
  pointsEvents        PointsEvent[]

  seasonPointsEvents SeasonPointsEvent[]
  seasonUserPoints   SeasonUserPoints[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPassword {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum GroupVisibility {
  PRIVATE
  PUBLIC
}

enum GroupMemberRole {
  MEMBER
  ADMIN
}

enum ScoringSystem {
  CLASSIC
}

enum Sport {
  SOCCER
  BASKETBALL
  TENNIS
  ESPORTS
}

model SportConfig {
  // Controls what sports are selectable in group creation.
  sport   Sport   @id
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Provider {
  THESPORTSDB
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELED
  UNKNOWN
}

model Group {
  id          String @id @default(cuid())
  name        String
  sport       Sport
  // Legacy/free-text competition label (kept for now to avoid breaking existing flows)
  competition String

  // Public groups can be browseable. Joinable controls whether users can opt-in.
  // Official global public groups are NOT joinable; membership is automatic.
  isJoinable Boolean @default(false)

  // Points can vary by scoring system. Groups with same season+scoringSystem share points.
  scoringSystem ScoringSystem @default(CLASSIC)

  // New: group is tied to a canonical competition season (enables shared fixtures)
  competitionSeasonId String?
  competitionSeason   CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)

  inviteCode String          @unique
  visibility GroupVisibility @default(PRIVATE)

  createdById String
  createdBy   User   @relation("UserCreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)

  members             GroupMember[]
  pointsEvents        PointsEvent[]
  officialPublicGroup OfficialPublicGroup?

  // Precomputed aggregates
  memberAccuracyAggregates GroupMemberAccuracyAggregate[]
  momentumAggregate        GroupMomentumAggregate?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visibility])
  @@index([createdById])
  @@index([sport])
  @@index([competitionSeasonId])
}

model OfficialPublicGroup {
  id                  String @id @default(cuid())
  competitionSeasonId String @unique
  groupId             String @unique

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  group             Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum SeasonPointsEventType {
  PREDICTION_SCORED
  PREDICTION_ADVANCES_BONUS
  GROUP_TABLE_BONUS
}

// Canonical scoring ledger per season+scoringSystem. This prevents double-scoring
// for users who are members of multiple groups in the same season.
model SeasonPointsEvent {
  id                  String        @id @default(cuid())
  competitionSeasonId String
  scoringSystem       ScoringSystem @default(CLASSIC)

  userId  String
  matchId String

  type   SeasonPointsEventType
  points Int
  reason String?
  meta   Json?

  createdAt DateTime @default(now())

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  match             Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([competitionSeasonId, scoringSystem, userId, matchId, type])
  @@index([competitionSeasonId])
  @@index([userId])
  @@index([matchId])
}

model SeasonUserPoints {
  id                  String        @id @default(cuid())
  competitionSeasonId String
  scoringSystem       ScoringSystem @default(CLASSIC)
  userId              String

  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionSeasonId, scoringSystem, userId])
  @@index([competitionSeasonId])
  @@index([userId])
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  points    Int             @default(0)
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

model GroupMemberAccuracyAggregate {
  id                String @id @default(cuid())
  groupId           String
  userId            String
  scoredTotal       Int    @default(0)
  correctTotal      Int    @default(0)
  last7d            Int    @default(0)
  prev7d            Int    @default(0)
  accuracyPctCached Float?

  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupMomentumAggregate {
  id      String @id @default(cuid())
  groupId String @unique

  totalScored         Int @default(0)
  correctScored       Int @default(0)
  memberCountSnapshot Int @default(0)
  momentumPctCached   Int @default(0)

  windowStart DateTime
  windowEnd   DateTime

  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model UserPredictionStatsAggregate {
  id     String @id @default(cuid())
  userId String @unique

  lifetimeTotal   Int   @default(0)
  lifetimeCorrect Int   @default(0)
  lifetimePoints  Int   @default(0)
  avgPoints       Float @default(0)

  recent30dTotal   Int @default(0)
  recent30dCorrect Int @default(0)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

enum PredictionSource {
  QUICK_PICK
  SCORE
}

model Prediction {
  id        String @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int

  // Knockout-only: if the user predicts a draw (after 120), they must pick who advances.
  // Leave null for league/group-stage matches and for non-draw predictions.
  advancesTeamId String?
  advancesTeam   Team?   @relation(fields: [advancesTeamId], references: [id], onDelete: SetNull)

  source PredictionSource @default(SCORE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([userId])
  @@index([matchId])
  @@index([advancesTeamId])
}

model Competition {
  id        String  @id @default(cuid())
  sport     Sport
  name      String
  country   String?
  published Boolean @default(false)

  provider         Provider?
  providerLeagueId String?

  seasons CompetitionSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerLeagueId])
  @@index([sport, published])
}

model CompetitionSeason {
  id            String  @id @default(cuid())
  competitionId String
  seasonLabel   String // e.g. "2026"
  published     Boolean @default(false)

  // Soft-delete / hide from admin + group creation without breaking existing relations.
  archivedAt DateTime?

  provider         Provider?
  providerSeasonId String?

  startsAt DateTime?
  endsAt   DateTime?

  // Standings sync metadata
  standingsUpdatedAt DateTime?

  // Fixtures sync metadata
  fixturesSyncedAt  DateTime?
  fixturesSyncError String?

  competition         Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phases              CompetitionPhase[]
  matches             Match[]
  standingsRows       StandingsRow[]
  groups              Group[]
  officialPublicGroup OfficialPublicGroup?

  seasonPointsEvents SeasonPointsEvent[]
  seasonUserPoints   SeasonUserPoints[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionId, seasonLabel])
  @@unique([provider, providerSeasonId])
  @@index([published])
  @@index([archivedAt])
}

enum CompetitionPhaseType {
  LEAGUE
  GROUP_STAGE
  KNOCKOUT
}

model CompetitionPhase {
  id                  String               @id @default(cuid())
  competitionSeasonId String
  name                String // e.g. "Regular Season"
  order               Int                  @default(0)
  type                CompetitionPhaseType @default(LEAGUE)

  competitionSeason CompetitionSeason  @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  matches           Match[]
  standingsRows     StandingsRow[]
  groups            CompetitionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionSeasonId, name])
  @@index([competitionSeasonId, type])
}

model CompetitionGroup {
  id                 String @id @default(cuid())
  competitionPhaseId String
  key                String // e.g. "A"
  name               String // e.g. "Group A"
  order              Int    @default(0)

  competitionPhase CompetitionPhase @relation(fields: [competitionPhaseId], references: [id], onDelete: Cascade)
  matches          Match[]
  standingsRows    StandingsRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitionPhaseId, key])
  @@index([competitionPhaseId, order])
}

model Team {
  id        String  @id @default(cuid())
  name      String
  shortName String?

  provider       Provider?
  providerTeamId String?

  homeMatches   Match[]        @relation("HomeTeam")
  awayMatches   Match[]        @relation("AwayTeam")
  standingsRows StandingsRow[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  predictions  Prediction[]
  matchResults MatchResult[]

  @@unique([provider, providerTeamId])
}

enum KnockoutRound {
  R128
  R64
  R32
  R16
  QF
  SF
  FINAL
  THIRD_PLACE
  PLAYOFF
  QUALIFIER
}

model Match {
  id                  String  @id @default(cuid())
  competitionSeasonId String
  competitionPhaseId  String?
  competitionGroupId  String?

  homeTeamId String
  awayTeamId String

  kickoffAt DateTime
  status    MatchStatus @default(SCHEDULED)

  provider         Provider?
  providerMatchId  String?
  providerRound    Int?
  providerGroupKey String?

  // For knockout matches (optional; can be derived from providerRound in importer)
  knockoutRound KnockoutRound?

  visibleAt DateTime?
  lockAt    DateTime?

  // Result + processing
  result             MatchResult?
  finalizedAt        DateTime?
  processedAt        DateTime?
  pointsEvents       PointsEvent[]
  seasonPointsEvents SeasonPointsEvent[]
  predictions        Prediction[]

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  competitionPhase  CompetitionPhase? @relation(fields: [competitionPhaseId], references: [id], onDelete: SetNull)
  competitionGroup  CompetitionGroup? @relation(fields: [competitionGroupId], references: [id], onDelete: SetNull)

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerMatchId])
  @@index([competitionSeasonId, kickoffAt])
  @@index([competitionPhaseId, kickoffAt])
  @@index([competitionGroupId, kickoffAt])
  @@index([status, kickoffAt])
}

model MatchResult {
  id        String @id @default(cuid())
  matchId   String @unique
  homeScore Int
  awayScore Int

  // Knockout-only: if the match is drawn after extra time and decided on penalties,
  // store who advanced.
  advancesTeamId String?
  advancesTeam   Team?   @relation(fields: [advancesTeamId], references: [id], onDelete: SetNull)

  provider        Provider?
  providerEventId String?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advancesTeamId])
}

enum PointsEventType {
  PREDICTION_SCORED
  PREDICTION_ADVANCES_BONUS
  GROUP_TABLE_BONUS
}

enum JobType {
  SCORE_MATCH
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model PointsEvent {
  id   String          @id @default(cuid())
  type PointsEventType @default(PREDICTION_SCORED)

  groupId String
  userId  String
  matchId String

  points Int

  reason String?
  meta   Json?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId, matchId, type])
  @@index([groupId, createdAt])
  @@index([userId, createdAt])
  @@index([matchId])
}

model Job {
  id     String    @id @default(cuid())
  type   JobType
  status JobStatus @default(QUEUED)

  // Used to make enqueuing idempotent (e.g. one SCORE_MATCH per matchId).
  // If null, the job is not deduped.
  dedupeKey String?

  payload Json

  runAt     DateTime  @default(now())
  lockedAt  DateTime?
  lockedBy  String?
  attempts  Int       @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, dedupeKey])
  @@index([status, runAt])
  @@index([lockedAt])
}

model StandingsRow {
  id                  String  @id @default(cuid())
  competitionSeasonId String
  competitionPhaseId  String?
  competitionGroupId  String?

  // A deterministic key that scopes the row (league table vs a specific group table).
  // Examples:
  // - season:<seasonId>:phase:<phaseId>
  // - season:<seasonId>:phase:<phaseId>:group:<groupId>
  scope String

  teamId String

  position       Int
  played         Int
  wins           Int
  draws          Int
  losses         Int
  goalsFor       Int @default(0)
  goalsAgainst   Int @default(0)
  goalDifference Int
  points         Int

  provider       Provider?
  providerTeamId String?

  competitionSeason CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  competitionPhase  CompetitionPhase? @relation(fields: [competitionPhaseId], references: [id], onDelete: SetNull)
  competitionGroup  CompetitionGroup? @relation(fields: [competitionGroupId], references: [id], onDelete: SetNull)
  team              Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, teamId])
  @@index([competitionSeasonId, position])
  @@index([competitionPhaseId, position])
  @@index([competitionGroupId, position])
  @@index([scope])
}
