// Prisma schema for Rivaly
// - PostgreSQL datasource
// - NextAuth/Auth.js (Prisma Adapter) tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional but recommended for serverless: use a pooled URL for runtime and a direct URL for migrations.
  // In Supabase, DATABASE_URL can point at the pooler (PgBouncer) and DIRECT_URL at the direct connection.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  country       String?
  role          UserRole  @default(USER)
  email         String?   @unique
  image         String?
  emailVerified DateTime?

  accounts Account[]
  sessions Session[]

  // Groups
  createdGroups    Group[]       @relation("UserCreatedGroups")
  groupMemberships GroupMember[]

  // Optional: only present for users who sign up with email+password.
  password UserPassword?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  groupPredictions    GroupPrediction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPassword {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum GroupVisibility {
  PRIVATE
  PUBLIC
}

enum GroupMemberRole {
  MEMBER
  ADMIN
}

enum Sport {
  SOCCER
  BASKETBALL
  TENNIS
  ESPORTS
}

model Group {
  id          String          @id @default(cuid())
  name        String
  sport       Sport
  competition String
  inviteCode  String          @unique
  visibility  GroupVisibility @default(PRIVATE)

  createdById String
  createdBy   User   @relation("UserCreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)

  members GroupMember[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  groupPredictions GroupPrediction[]

  @@index([visibility])
  @@index([createdById])
  @@index([sport])
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  points    Int             @default(0)
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

enum PredictionSource {
  QUICK_PICK
  SCORE
}

model GroupPrediction {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  matchKey  String
  homeScore Int
  awayScore Int
  source    PredictionSource @default(SCORE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, matchKey])
  @@index([groupId])
  @@index([userId])
  @@index([matchKey])
}
