// Prisma schema for Rivaly
// - PostgreSQL datasource
// - NextAuth/Auth.js (Prisma Adapter) tables

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional but recommended for serverless: use a pooled URL for runtime and a direct URL for migrations.
  // In Supabase, DATABASE_URL can point at the pooler (PgBouncer) and DIRECT_URL at the direct connection.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  country       String?
  role          UserRole  @default(USER)
  email         String?   @unique
  image         String?
  emailVerified DateTime?

  accounts Account[]
  sessions Session[]

  // Groups
  createdGroups    Group[]       @relation("UserCreatedGroups")
  groupMemberships GroupMember[]

  // Optional: only present for users who sign up with email+password.
  password UserPassword?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  groupPredictions    GroupPrediction[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPassword {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum GroupVisibility {
  PRIVATE
  PUBLIC
}

enum GroupMemberRole {
  MEMBER
  ADMIN
}

enum Sport {
  SOCCER
  BASKETBALL
  TENNIS
  ESPORTS
}

enum Provider {
  THESPORTSDB
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELED
  UNKNOWN
}

model Group {
  id          String          @id @default(cuid())
  name        String
  sport       Sport
  // Legacy/free-text competition label (kept for now to avoid breaking existing flows)
  competition String

  // New: group is tied to a canonical competition season (enables shared fixtures)
  competitionSeasonId String?
  competitionSeason   CompetitionSeason? @relation(fields: [competitionSeasonId], references: [id], onDelete: SetNull)

  inviteCode  String          @unique
  visibility  GroupVisibility @default(PRIVATE)

  createdById String
  createdBy   User   @relation("UserCreatedGroups", fields: [createdById], references: [id], onDelete: Cascade)

  members GroupMember[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  groupPredictions GroupPrediction[]

  @@index([visibility])
  @@index([createdById])
  @@index([sport])
  @@index([competitionSeasonId])
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  points    Int             @default(0)
  createdAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId])
}

enum PredictionSource {
  QUICK_PICK
  SCORE
}

model GroupPrediction {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  matchKey  String
  homeScore Int
  awayScore Int
  source    PredictionSource @default(SCORE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, matchKey])
  @@index([groupId])
  @@index([userId])
  @@index([matchKey])
}

model Competition {
  id               String   @id @default(cuid())
  sport            Sport
  name             String
  country          String?
  published        Boolean  @default(false)

  provider         Provider?
  providerLeagueId String?

  seasons          CompetitionSeason[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, providerLeagueId])
  @@index([sport, published])
}

model CompetitionSeason {
  id               String   @id @default(cuid())
  competitionId    String
  seasonLabel      String // e.g. "2026"
  published        Boolean  @default(false)

  provider         Provider?
  providerSeasonId String?

  startsAt         DateTime?
  endsAt           DateTime?

  // Standings sync metadata
  standingsUpdatedAt DateTime?

  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  phases           CompetitionPhase[]
  matches          Match[]
  standingsRows    StandingsRow[]
  groups           Group[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([competitionId, seasonLabel])
  @@unique([provider, providerSeasonId])
  @@index([published])
}

model CompetitionPhase {
  id                 String   @id @default(cuid())
  competitionSeasonId String
  name               String   // e.g. "Regular Season"
  order              Int      @default(0)

  competitionSeason  CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  matches            Match[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([competitionSeasonId, name])
}

model Team {
  id              String   @id @default(cuid())
  name            String
  shortName       String?

  provider        Provider?
  providerTeamId  String?

  homeMatches     Match[]  @relation("HomeTeam")
  awayMatches     Match[]  @relation("AwayTeam")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerTeamId])
}

model Match {
  id                   String      @id @default(cuid())
  competitionSeasonId  String
  competitionPhaseId   String?

  homeTeamId           String
  awayTeamId           String

  kickoffAt            DateTime
  status               MatchStatus @default(SCHEDULED)

  provider             Provider?
  providerMatchId      String?

  visibleAt            DateTime?
  lockAt               DateTime?

  // Result + processing
  result               MatchResult?
  finalizedAt          DateTime?
  processedAt          DateTime?

  competitionSeason    CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  competitionPhase     CompetitionPhase? @relation(fields: [competitionPhaseId], references: [id], onDelete: SetNull)

  homeTeam             Team @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam             Team @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([provider, providerMatchId])
  @@index([competitionSeasonId, kickoffAt])
  @@index([status, kickoffAt])
}

model MatchResult {
  id          String @id @default(cuid())
  matchId     String @unique
  homeScore   Int
  awayScore   Int

  provider    Provider?
  providerEventId String?

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PointsEventType {
  PREDICTION_SCORED
}

model PointsEvent {
  id        String @id @default(cuid())
  type      PointsEventType @default(PREDICTION_SCORED)

  groupId   String
  userId    String
  matchId   String

  points    Int

  reason    String?
  meta      Json?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, userId, matchId, type])
  @@index([groupId, createdAt])
  @@index([userId, createdAt])
  @@index([matchId])
}

model StandingsRow {
  id                  String @id @default(cuid())
  competitionSeasonId String
  competitionPhaseId  String?

  teamId              String

  position            Int
  played              Int
  wins                Int
  draws               Int
  losses              Int
  goalDifference      Int
  points              Int

  provider            Provider?
  providerTeamId      String?

  competitionSeason   CompetitionSeason @relation(fields: [competitionSeasonId], references: [id], onDelete: Cascade)
  competitionPhase    CompetitionPhase? @relation(fields: [competitionPhaseId], references: [id], onDelete: SetNull)
  team                Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([competitionSeasonId, teamId])
  @@unique([provider, providerTeamId])
  @@index([competitionSeasonId, position])
}
