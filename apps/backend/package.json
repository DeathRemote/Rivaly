{
  "name": "rivaly-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:prepare": "node scripts/prepare-prisma.mjs",
    "prisma:generate": "npm run prisma:prepare && prisma generate --schema prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.16.1",
    "@types/node": "^20.19.0",
    "fastify": "^5.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
