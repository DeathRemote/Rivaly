    "@types/node": "^20.19.0",
    "fastify": "^5.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
